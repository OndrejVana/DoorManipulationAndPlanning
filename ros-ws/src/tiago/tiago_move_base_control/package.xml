<?xml version="1.0"?>
<package format="2">
  <name>tiago_move_base_control</name>
  <version>0.0.1</version>
  <description>move_base for TIAGo with the DoorMaskLayer costmap plugin (ROS1 Melodic)</description>

  <maintainer email="you@todo.todo">you</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>costmap_2d</depend>
  <depend>geometry_msgs</depend>
  <depend>pluginlib</depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>move_base</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>base_local_planner</exec_depend>

  <export>
    <costmap_2d plugin="${prefix}/plugin.xml" />
  </export>
</package>
