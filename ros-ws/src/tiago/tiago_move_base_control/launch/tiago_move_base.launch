<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <!-- Move base node with custom namespace -->
  <group ns="tiago_move_base">
    <node name="move_base" pkg="move_base" type="move_base" respawn="false" output="screen">

      <!-- Remaps -->
      <remap from="cmd_vel" to="/mobile_base_controller/cmd_vel"/>
      <remap from="map" to="/map"/>

      <!-- Planners -->
      <param name="base_global_planner" value="navfn/NavfnROS" />
      <param name="base_local_planner"  value="base_local_planner/TrajectoryPlannerROS" />

      <rosparam param="NavfnROS">
        allow_unknown: true
        default_tolerance: 0.1
      </rosparam>

      <rosparam param="TrajectoryPlannerROS">
        max_vel_x: 0.2
        min_vel_x: 0.05
        max_vel_theta: 1.0
        min_in_place_vel_theta: 0.4
        acc_lim_theta: 3.2
        acc_lim_x: 2.5
        acc_lim_y: 2.5
        holonomic_robot: false
        yaw_goal_tolerance: 0.05
        xy_goal_tolerance: 0.05
        latch_xy_goal_tolerance: false
      </rosparam>

      <!-- Obstacles from the base laser only -->
      <rosparam param="global_costmap">
        global_frame: map
        robot_base_frame: base_footprint
        update_frequency: 2.0
        publish_frequency: 1.0
        transform_tolerance: 5.0

        # The live rtabmap grid (/map), plus what the laser sees now. open_door plans on this costmap.
        static_map: true
        rolling_window: false
        resolution: 0.05

        plugins:
          - {name: static_layer, type: "costmap_2d::StaticLayer"}
          - {name: obstacle_layer, type: "costmap_2d::ObstacleLayer"}
          - {name: door_mask, type: "tiago_move_base_control/DoorMaskLayer"}
          - {name: inflation_layer, type: "costmap_2d::InflationLayer"}

        static_layer:
          map_topic: /map
          subscribe_to_updates: true

        obstacle_layer:
          observation_sources: scan
          scan: {topic: /scan, data_type: LaserScan, marking: true, clearing: true, obstacle_range: 4.0, raytrace_range: 5.0}

        # The door's swing sector, published by the door mission (the planner models the leaf itself).
        door_mask:
          polygon_topic: /door_mask/polygon
          enabled_topic: /door_mask/enabled

        inflation_layer:
          inflation_radius: 0.1
          cost_scaling_factor: 10.0
      </rosparam>

      <!-- Only live sensors: the leaf is a real obstacle near the robot. -->
      <rosparam param="local_costmap">
        global_frame: odom
        robot_base_frame: base_footprint
        update_frequency: 5.0
        publish_frequency: 2.0
        transform_tolerance: 5.0

        static_map: false
        rolling_window: true
        width: 4.0
        height: 4.0
        resolution: 0.05

        plugins:
          - {name: obstacle_layer, type: "costmap_2d::ObstacleLayer"}
          - {name: inflation_layer, type: "costmap_2d::InflationLayer"}

        obstacle_layer:
          observation_sources: scan
          scan: {topic: /scan, data_type: LaserScan, marking: true, clearing: true, obstacle_range: 4.0, raytrace_range: 5.0}

        inflation_layer:
          inflation_radius: 0.1
          cost_scaling_factor: 10.0
      </rosparam>

      <!-- Same base radius as tiago_door_planning (collision/base_radius). -->
      <param name="robot_radius" value="0.30"/>

    </node>
  </group>

</launch>