<?xml version="1.0"?>
<launch>
  <!-- Global Configuration -->
  <arg name="simulation" default="false" doc="true = Gazebo sim, false = real robot"/>
  <arg name="use_slam" default="true" doc="Enable SLAM for mapping and localization"/>
  <arg name="use_door_perception" default="true" doc="Enable AprilTag-based door detection"/>
  <arg name="use_navigation" default="true" doc="move_base with the door-masked costmap open_door plans on"/>
  <arg name="use_door_planning" default="true" doc="open_door / pass_door / execute_door_segment servers"/>
  <arg name="use_mission" default="true" doc="Door mission; idles until rosservice call /door_mission/start"/>
  <arg name="mission_dry_run" default="false" doc="Mission plans only: nothing moves"/>
  <arg name="use_vicon" default="false" doc="Enable VICON motion capture system"/>
  <arg name="rviz" default="false" doc="Launch RViz for visualization"/>

  
  <!-- Simulation Configuration -->
  <arg name="world_file" default="$(find tiago_door_sim)/worlds/small_office_with_door.world"/>
  <!-- robot: iron (no-arm), steel (gripper), titanium (hey5), tiago++ (dual-arm) -->
  <arg name="robot" default="tiago++" doc="Robot model: iron, steel, titanium, or tiago++"/>
  <!-- Single-arm variants -->
  <arg name="arm" default="$(eval arg('robot') not in ['iron'])"/>
  <arg name="end_effector" default="$(eval {'iron': 'false', 'steel': 'pal-gripper', 'titanium': 'pal-hey5'}.get(arg('robot'), 'pal-hey5'))"/>
  <arg name="end_effector_left"  default="pal-hey5" doc="Tiago++ left arm end-effector (pal-hey5 or pal-gripper)"/>
  <arg name="end_effector_right" default="pal-hey5" doc="Tiago++ right arm end-effector (pal-hey5 or pal-gripper)"/>
  <arg name="laser_model" default="sick-571"/>
  <arg name="camera_model" default="orbbec-astra"/>
  <arg name="gui" default="true" doc="Show Gazebo GUI"/>
  <arg name="gzpose" default="-x 0.0 -y 0.0 -z 0.0 -R 0.0 -P 0.0 -Y 0.0"/>

  <!-- Door model: the sim's doors differ from the lab door -->
  <arg name="door_motion_overrides" default="$(eval find('tiago_door_planning') + '/config/door_motion_sim.yaml' if arg('simulation') else '')"/>

  <!-- Door Perception Config -->
  <arg name="door_config" default="$(eval find('tiago_door_localization') + '/config/' + ('apriltag_sim_doors.yaml' if arg('simulation') else 'apriltag_two_sided_door.yaml'))"/>

  <!-- Launch Components -->

  <!-- 1. Simulation / Robot -->
  <group if="$(arg simulation)">
    <include file="$(find tiago_door_sim)/launch/sim_with_door.launch">
      <arg name="world_file" value="$(arg world_file)"/>
      <arg name="robot" value="$(arg robot)"/>
      <arg name="arm" value="$(arg arm)"/>
      <arg name="end_effector" value="$(arg end_effector)"/>
      <arg name="end_effector_left"  value="$(arg end_effector_left)"/>
      <arg name="end_effector_right" value="$(arg end_effector_right)"/>
      <arg name="laser_model" value="$(arg laser_model)"/>
      <arg name="camera_model" value="$(arg camera_model)"/>
      <arg name="gui" value="$(arg gui)"/>
      <arg name="gzpose" value="$(arg gzpose)"/>
    </include>
  </group>

  <!-- 2. SLAM System -->
  <group if="$(arg use_slam)">
    <group unless="$(arg simulation)">
      <node name="kill_pal_nav_nodes" pkg="tiago_slam" type="kill_pal_nav_nodes.py"
            output="screen"/>
    </group>
    <include file="$(find tiago_slam)/launch/tiago_slam.launch"/>
  </group>

  <!-- 3. Door Perception -->
  <group if="$(arg use_door_perception)">
    <include file="$(find tiago_door_localization)/launch/door_preception_tags.launch">
      <arg name="config" value="$(arg door_config)"/>
    </include>
  </group>

  <!-- 4. Navigation Control -->
  <group if="$(arg use_navigation)">
    <include file="$(find tiago_move_base_control)/launch/tiago_move_base.launch"/>
  </group>

  <!-- 5. Door Opening (plan, grasp, track, regrasp) -->
  <group if="$(arg use_door_planning)">
    <include file="$(find tiago_door_planning)/launch/door_opening.launch">
      <arg name="overrides" value="$(arg door_motion_overrides)"/>
    </include>
  </group>

  <!-- 6. Door mission (lock the door, approach, open, drive through) -->
  <group if="$(arg use_mission)">
    <include file="$(find tiago_door_mission)/launch/door_mission.launch">
      <arg name="dry_run" value="$(arg mission_dry_run)"/>
      <arg name="door_motion_overrides" value="$(arg door_motion_overrides)"/>
    </include>
  </group>

  <!-- 7. VICON (Optional) -->
  <group if="$(arg use_vicon)">
    <include file="$(find tiago_vicon)/launch/tiago_vicon.launch"/>
  </group>

  <!-- 8. Visualization (RViz) -->
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" output="screen"
          args="-d $(find tiago_door_bringup)/rviz/tiago_door_main.rviz" />
  </group>

</launch>
