<?xml version="1.0"?>
<package format="2">
  <name>tiago_door_mission</name>
  <version>0.1.0</version>
  <description>SMACH door mission: lock the door in view, approach, open with tiago_door_planning, drive through.</description>

  <maintainer email="you@todo.todo">you</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>rospy</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>smach</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>play_motion_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tiago_door_planning</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
</package>
