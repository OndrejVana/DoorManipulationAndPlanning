<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="config" default="$(find tiago_door_planning)/config/door_motion.yaml"/>

  <node pkg="tiago_door_planning" type="door_tracking_server.py" name="door_tracking_server" output="screen">
    <rosparam command="load" file="$(arg config)"/>
  </node>
</launch>
